PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase project credentials (Server-side only: use Service Role Key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Strong random secret for signing JWT session cookies (at least 32 chars)
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d
